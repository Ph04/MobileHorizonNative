<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="MobileHorizon Native"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NativeGameActivity"
            android:process=":game"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="Horizon Java Client"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/NativeGameTheme">
            <meta-data
                android:name="android.app.lib_name"
                android:value="horizon_android" />
        </activity>

        <service
            android:name=".OfficialDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".ResourcePreparationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".MicrosoftAuthService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".CursorGestureAccessibilityService"
            android:label="@string/cursor_gesture_service_label"
            android:description="@string/cursor_gesture_service_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/cursor_gesture_accessibility_service" />
        </service>
    </application>
</manifest>
