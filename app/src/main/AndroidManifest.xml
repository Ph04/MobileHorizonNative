<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="MobileHorizon Native"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WorldsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="Mundos" />

        <activity android:name=".LibraryActivity" android:configChanges="orientation|screenSize|keyboardHidden" android:exported="false" android:label="Biblioteca" />
        <activity android:name=".SettingsActivity" android:configChanges="orientation|screenSize|keyboardHidden" android:exported="false" android:label="Configurações e novidades" />

        <activity android:name=".ProfilesActivity" android:configChanges="orientation|screenSize|keyboardHidden" android:exported="false" android:label="Perfis e contas" />

        <activity android:name=".SkinCapeActivity" android:configChanges="orientation|screenSize|keyboardHidden" android:exported="false" android:label="Skins e capas" />

        <activity android:name=".ServerFavoritesActivity" android:configChanges="orientation|screenSize|keyboardHidden" android:exported="false" android:label="Servidores favoritos" />

        <activity android:name=".ContentBrowserActivity" android:configChanges="orientation|screenSize|keyboardHidden" android:exported="false" android:label="Explorar conteúdo" />

        <activity android:name=".ScreenshotsActivity" android:configChanges="orientation|screenSize|keyboardHidden" android:exported="false" android:label="Capturas de tela" />

        <activity android:name=".ConsoleActivity" android:configChanges="orientation|screenSize|keyboardHidden" android:exported="false" android:label="Console e logs" />

        <activity
            android:name=".InstancesActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="Instâncias" />

        <activity
            android:name=".CompatibilityModulesActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="Módulos de compatibilidade" />

        <activity
            android:name=".ResourceManagerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="Gerenciador de recursos" />

        <activity
            android:name=".TouchControlsEditorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="Personalizar controles"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/NativeGameTheme" />

        <activity
            android:name=".NativeGameActivity"
            android:process=":game"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="Horizon Java Client"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/NativeGameTheme">
            <meta-data
                android:name="android.app.lib_name"
                android:value="horizon_android" />
        </activity>

        <service
            android:name=".OfficialDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".ResourcePreparationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".MicrosoftAuthService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
